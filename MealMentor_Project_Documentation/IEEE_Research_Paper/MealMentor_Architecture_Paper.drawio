        <mxCell id="l5" value="Filtered Candidates" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#7F1D1D;backgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e5">
