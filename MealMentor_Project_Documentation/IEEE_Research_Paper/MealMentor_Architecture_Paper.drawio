        <mxCell id="l4" value="Nutrient Deficits (Gk)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#7C2D12;backgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e4">
