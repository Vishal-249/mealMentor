        <!-- Gateway -> Nutrition & Recommend -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=classic;strokeColor=#22C55E;strokeWidth=1.5;" edge="1" parent="1" source="modGateway" target="modNutrition">
