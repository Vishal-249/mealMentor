        <!-- ML Module -> Core -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=classic;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="modML" target="modCore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Monolith <-> External Cloud -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#A855F7;strokeWidth=2;" edge="1" parent="1" source="modGateway" target="extCloud">
