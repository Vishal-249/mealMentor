        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=none;endArrow=classic;strokeColor=#EF4444;strokeWidth=2;" edge="1" parent="1" source="modRecommend" target="modML">
