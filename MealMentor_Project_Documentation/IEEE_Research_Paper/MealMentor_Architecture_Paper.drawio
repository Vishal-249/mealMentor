        <!-- Core <-> MongoDB -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#06B6D4;strokeWidth=2;" edge="1" parent="1" source="modCore" target="extDB">
